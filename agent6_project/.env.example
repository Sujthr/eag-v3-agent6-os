# ── LLM Gateway V3 ──────────────────────────────────────────────────────────
# The gateway reads these from the root .env — copy to project root too.
# Gateway runs at http://localhost:8101 by default.
LLM_GATEWAY_V3_URL=http://localhost:8101

# ── Required: at least one LLM provider ─────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here       # required for Perception layer
GROQ_API_KEY=your-groq-api-key-here
CEREBRAS_API_KEY=your-cerebras-api-key-here
NVIDIA_API_KEY=your-nvidia-api-key-here
GITHUB_ACCESS_TOKEN=your-github-pat-here
OPEN_ROUTER_API_KEY=your-openrouter-key-here

# ── MCP server tools ─────────────────────────────────────────────────────────
TAVILY_API_KEY=your-tavily-api-key-here       # for web_search (primary)
# DuckDuckGo is used as fallback — no key needed

# ── Optional model overrides ─────────────────────────────────────────────────
# Gateway worker models (used by the gateway server, not by agent6 directly)
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
GITHUB_MODEL=openai/gpt-4.1-mini

# Agent6 layer-specific model overrides
# Perception uses Gemini 2.5 Flash-Lite by default for stable goal management
GEMINI_PERCEPTION_MODEL=gemini-2.5-flash-lite-preview-06-17

# Memory classification uses auto_route by default; pin a model here if desired
# MEMORY_MODEL=
